datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Users {
  id          Int      @id @default(autoincrement())
  phoneNumber String
  name        String
  createdAt   DateTime @default(now())
  deleted     Boolean

  @@unique([phoneNumber])
}
